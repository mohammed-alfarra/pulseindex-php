{
    "name": "pulseindex/pulseindex-php",
    "description": "Official PHP client SDK for the PulseIndex bitwise search engine",
    "type": "library",
    "license": "MIT",
    "keywords": ["pulseindex", "grpc", "search", "indexing", "laravel"],
    "authors": [
        {
            "name": "PulseIndex"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-grpc": "*",
        "grpc/grpc": "^1.57",
        "google/protobuf": "^4.28"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "illuminate/support": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "PulseIndex\\": "src/",
            "PulseIndex\\Engine\\V1\\": "generated/PulseIndex/Engine/V1/",
            "GPBMetadata\\PulseIndex\\": "generated/GPBMetadata/PulseIndex/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PulseIndex\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PulseIndex\\Laravel\\PulseIndexServiceProvider"
            ],
            "aliases": {
                "PulseIndex": "PulseIndex\\Laravel\\Facades\\PulseIndex"
            }
        }
    },
    "scripts": {
        "build-proto": "bash scripts/compile-proto.sh",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
