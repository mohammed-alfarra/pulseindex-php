{
    "name": "pulseindex/pulseindex-php",
    "description": "Official PHP client SDK for the PulseIndex bitwise search engine",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "pulseindex",
        "grpc",
        "search",
        "indexing",
        "laravel"
    ],
    "authors": [
        {
            "name": "PulseIndex"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-grpc": "*",
        "grpc/grpc": "^1.57",
        "google/protobuf": "^4.28"
    },
    "require-dev": {
        "illuminate/database": "^11.0 || ^12.0",
        "illuminate/pagination": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0",
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "illuminate/database": "Required to use the PulseSearchable Eloquent trait and hydrator",
        "illuminate/pagination": "Required to use PulseQueryBuilder::paginate()",
        "illuminate/support": "Required for the Laravel service provider and facade"
    },
    "autoload": {
        "psr-4": {
            "PulseIndex\\": "src/",
            "PulseIndex\\Engine\\V1\\": "generated/PulseIndex/Engine/V1/",
            "GPBMetadata\\PulseIndex\\": "generated/GPBMetadata/PulseIndex/",
            "Grpc\\Health\\V1\\": "generated/Grpc/Health/V1/",
            "GPBMetadata\\": "generated/GPBMetadata/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PulseIndex\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PulseIndex\\Laravel\\PulseIndexServiceProvider"
            ],
            "aliases": {
                "PulseIndex": "PulseIndex\\Laravel\\Facades\\PulseIndex"
            }
        }
    },
    "scripts": {
        "build-proto": "bash scripts/compile-proto.sh",
        "check:proto": "php scripts/check-proto.php",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "check:proto:ci": "php scripts/check-proto.php --require-engine"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
